{
  "color": {
    "bg": {
      "default": { "$value": "{color.base.white}", "$type": "color", "$description": "メイン背景色" },
      "primary": { "$value": "{color.base.blue.500}", "$type": "color", "$description": "プライマリアクション背景色" },
      "primaryHover": { "$value": "{color.base.blue.600}", "$type": "color", "$description": "プライマリアクション(Hover時)" }
    },
    "text": {
      "default": { "$value": "{color.base.gray.900}", "$type": "color" },
      "inverse": { "$value": "{color.base.white}", "$type": "color" },
      "muted": { "$value": "{color.base.gray.500}", "$type": "color" }
    }
  },
  "size": {
    "spacing": {
      "sm": { "$value": "{spacing.base.2}", "$type": "dimension" },
      "md": { "$value": "{spacing.base.4}", "$type": "dimension" },
      "lg": { "$value": "{spacing.base.8}", "$type": "dimension" }
    }
  }
