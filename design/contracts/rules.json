{
  "name": "Global Design Rules",
  "description": "プロジェクト全体に適用される禁止ルールおよび制約",
  "forbiddenStyles": [
    "margin",
    "margin-top",
    "margin-bottom",
    "margin-left",
    "margin-right",
    "float",
    "clear"
  ],
  "allowedUnits": {
    "spacing": ["rem", "em", "vw", "px", "auto"],
    "fontSize": ["rem", "em", "vw", "px"],
    "border": ["px"]
  },
  "namingRules": {
    "forbiddenKeys": ["prop", "var", "val", "default", "type"]
  },
  "spacingRules": {
    "gridBasePx": 4,
    "allowedMicroOffsets": [1, 2, 3]
  },
  "a11y": {
    "minimumContrastRatio": 4.5,
    "requireFocusVisible": true
  }
}
