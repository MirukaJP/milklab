{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "W3C DTCG Design Tokens Schema",
  "description": "デザイントークンの構造とエイリアスを定義するメタスキーマ",
  "type": "object",
  "patternProperties": {
    "^[a-zA-Z0-9_-]+$": {
      "anyOf": [
        { "$ref": "#/definitions/tokenGroup" },
        { "$ref": "#/definitions/token" }
      ]
    }
  },
  "definitions": {
    "tokenGroup": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "anyOf": [
            { "$ref": "#/definitions/tokenGroup" },
            { "$ref": "#/definitions/token" }
          ]
        }
      },
      "additionalProperties": false
    },
    "token": {
      "type": "object",
      "properties": {
        "$value": {
          "type": ["string", "number", "object"],
          "description": "トークンの絶対値、またはエイリアス参照({path.to.token})"
        },
        "$type": {
          "type": "string",
          "enum": ["color", "dimension", "fontFamily", "fontWeight", "duration", "cubicBezier", "shadow"],
          "description": "トークンの型"
        },
        "$description": {
          "type": "string"
        }
      },
      "required": ["$value"]
    }
  },
  "additionalProperties": false
}
